---
import Mark from "./Mark.astro";
import { altLangPath, type Lang, type Dict } from "../i18n";

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: "#work", num: "01", label: t.nav.work },
  { href: "#skills", num: "02", label: t.nav.skills },
  { href: "#trayectoria", num: "03", label: t.trayectoria.title },
  { href: "#case", num: "04", label: t.nav.case },
  { href: "#contact", num: "06", label: t.nav.contact },
];
const esHref = altLangPath(path, "es");
const enHref = altLangPath(path, "en");
---

<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-ink focus:text-paper focus:px-4 focus:py-2 focus:font-mono focus:text-sm">
  {t.nav.skipToContent}
</a>

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md"
  style="height: var(--header-h)"
>
  <div class="shell flex h-full items-center justify-between gap-4">
    <!-- Marca -->
    <a href={lang === "es" ? "/" : "/en/"} class="group flex items-center gap-2.5" aria-label="AZTYX">
      <Mark size={26} class="text-ink transition-transform duration-500 ease-swiss group-hover:-translate-y-0.5" />
      <span class="flex items-baseline gap-1.5">
        <span class="text-[1.05rem] font-extrabold tracking-tight text-ink">AZTYX</span>
        <span class="hidden font-mono text-[0.7rem] text-grey sm:inline">/xalixme</span>
      </span>
    </a>

    <!-- Navegación de escritorio -->
    <nav class="hidden items-center gap-7 md:flex" aria-label="Principal">
      {
        links.map((l) => (
          <a href={l.href} class="group flex items-baseline gap-1.5 font-mono text-[0.82rem] text-ink">
            <span class="text-[0.62rem] text-grey">{l.num}</span>
            <span class="link-ul">{l.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <!-- Estado de disponibilidad -->
      <span class="hidden items-center gap-2 font-mono text-[0.7rem] text-grey lg:flex">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ultra opacity-60 motion-reduce:hidden"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-ultra"></span>
        </span>
        {t.status.available}
      </span>

      <!-- Toggle de idioma -->
      <div class="flex items-center font-mono text-[0.8rem]" aria-label={t.nav.langLabel}>
        <a
          href={esHref}
          hreflang="es"
          aria-current={lang === "es" ? "true" : undefined}
          class:list={["px-1", lang === "es" ? "font-semibold text-ink" : "text-grey hover:text-ink"]}
        >ES</a>
        <span class="text-line" aria-hidden="true">/</span>
        <a
          href={enHref}
          hreflang="en"
          aria-current={lang === "en" ? "true" : undefined}
          class:list={["px-1", lang === "en" ? "font-semibold text-ink" : "text-grey hover:text-ink"]}
        >EN</a>
      </div>

      <!-- Botón de menú (móvil) -->
      <button
        type="button"
        id="menu-btn"
        class="flex h-9 w-9 items-center justify-center md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t.nav.menu}
      >
        <span class="relative block h-[2px] w-6 bg-ink before:absolute before:-top-2 before:block before:h-[2px] before:w-6 before:bg-ink before:content-[''] after:absolute after:top-2 after:block after:h-[2px] after:w-6 after:bg-ink after:content-['']"></span>
      </button>
    </div>
  </div>

  <!-- Panel de navegación móvil -->
  <nav
    id="mobile-nav"
    hidden
    class="border-b border-line bg-paper md:hidden"
    aria-label="Principal (móvil)"
  >
    <ul class="shell flex flex-col py-2">
      {
        links.map((l) => (
          <li class="border-b border-line/60 last:border-0">
            <a href={l.href} class="flex items-baseline gap-3 py-3 font-mono text-base text-ink" data-mobile-link>
              <span class="text-xs text-grey">{l.num}</span>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Menú móvil: toggle accesible (aria-expanded) + cierre al elegir un enlace.
  function setupMenu() {
    const btn = document.getElementById("menu-btn");
    const nav = document.getElementById("mobile-nav");
    if (!btn || !nav) return;
    const close = () => {
      btn.setAttribute("aria-expanded", "false");
      nav.hidden = true;
    };
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      nav.hidden = open;
    });
    nav.querySelectorAll("[data-mobile-link]").forEach((a) => a.addEventListener("click", close));
  }
  document.addEventListener("astro:page-load", setupMenu);
</script>
