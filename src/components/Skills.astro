---
import SectionHead from "./SectionHead.astro";
import { type Dict } from "../i18n";
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const s = t.skills;
// Iconos SVG propios, uno por grupo (dibujados a mano, cero stock).
---

<section id="skills" class="scroll-mt-24 py-20 sm:py-28">
  <div class="shell">
    <SectionHead num={s.num} title={s.title} lead={s.lead} />

    <div class="mt-14 grid grid-cols-1 gap-px overflow-hidden border border-line bg-line md:grid-cols-2">
      {
        s.groups.map((g, gi) => (
          <article class="group relative bg-paper p-7 sm:p-9" data-reveal style={`--reveal-delay:${gi * 90}ms`}>
            {/* Filete de acento que crece en hover */}
            <span class="absolute left-0 top-0 h-full w-[3px] origin-top scale-y-0 bg-ultra transition-transform duration-500 ease-swiss group-hover:scale-y-100" aria-hidden="true" />
            <div class="mb-5 flex items-center justify-between">
              <h3 class="text-xl font-bold tracking-tight text-ink">{g.k}</h3>
              <span class="text-grey transition-colors duration-300 group-hover:text-ultra" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {gi === 0 && (
                    <g>
                      <rect x="6" y="9" width="36" height="30" rx="2" />
                      <line x1="6" y1="17" x2="42" y2="17" />
                      <line x1="14" y1="25" x2="14" y2="33" />
                      <line x1="22" y1="25" x2="34" y2="25" />
                      <line x1="22" y1="31" x2="30" y2="31" />
                      <circle cx="10" cy="13" r="1" fill="currentColor" stroke="none" />
                    </g>
                  )}
                  {gi === 1 && (
                    <g>
                      <ellipse cx="24" cy="12" rx="14" ry="5" />
                      <path d="M10 12 v10 c0 2.8 6.3 5 14 5 s14-2.2 14-5 V12" />
                      <path d="M10 22 v10 c0 2.8 6.3 5 14 5 s14-2.2 14-5 V22" />
                    </g>
                  )}
                  {gi === 2 && (
                    <g>
                      <rect x="6" y="10" width="36" height="28" rx="2" />
                      <path d="M13 20 l5 4 -5 4" />
                      <line x1="22" y1="28" x2="32" y2="28" />
                    </g>
                  )}
                  {gi === 3 && (
                    <g>
                      <circle cx="24" cy="24" r="4" />
                      <circle cx="10" cy="12" r="3" />
                      <circle cx="38" cy="12" r="3" />
                      <circle cx="12" cy="37" r="3" />
                      <circle cx="37" cy="36" r="3" />
                      <line x1="21" y1="21" x2="12" y2="14" />
                      <line x1="27" y1="21" x2="36" y2="14" />
                      <line x1="21" y1="27" x2="13" y2="34" />
                      <line x1="27" y1="26" x2="35" y2="34" />
                    </g>
                  )}
                </svg>
              </span>
            </div>
            <ul class="flex flex-wrap gap-x-2 gap-y-2">
              {g.tags.map((tag) => (
                <li class="border border-line px-2.5 py-1 font-mono text-[0.74rem] text-ink-soft transition-colors duration-200 hover:border-ink hover:text-ink">
                  {tag}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
